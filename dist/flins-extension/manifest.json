{
  "manifest_version": 3,
  "name": "洛谷 · 菲林斯主题「终夜长茔 · 夜巡」",
  "version": "2026.1005.1507",
  "description": "为洛谷换上《原神》菲林斯主题：深靛蓝夜色 + 提灯冷蓝焰 + 金色新月 + 灯塔剪影。背景图片可在设置面板里随时更换。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.luogu.com.cn/*",
        "*://*.luogu.com/*",
        "*://*.luogu.me/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "content.js"
      ]
    }
  ]
}
